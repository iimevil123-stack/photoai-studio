{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(npx next *)",
      "Bash(npx kill-port *)",
      "Bash(curl -s http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\" http://localhost:3001/scene)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\" http://localhost:3001/scene/portrait)",
      "Bash(curl -s -o /dev/null -w \"scene: %{http_code} | \" http://localhost:3000/scene)",
      "Bash(curl -s -o /dev/null -w \"portrait: %{http_code} | \" http://localhost:3000/scene/portrait)",
      "Bash(curl -s -o /dev/null -w \"ecommerce: %{http_code} | \" http://localhost:3000/scene/ecommerce)",
      "Bash(curl -s -o /dev/null -w \"anime: %{http_code}\" http://localhost:3000/scene/anime)",
      "Bash(curl -s -L http://localhost:3000/scene)",
      "Bash(curl *)",
      "Bash(grep -rnP '[\\\\xE0-\\\\xFF]{4,}' src --include=\"*.tsx\" --include=\"*.ts\" --include=\"*.css\")",
      "Bash(xargs -0 -I{} sh -c 'file -bi \"{}\" 2>/dev/null | grep -v \"utf-8\\\\|us-ascii\\\\|binary\" && echo \"{}\"')"
    ]
  }
}
